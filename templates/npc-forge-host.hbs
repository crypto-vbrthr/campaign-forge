<div class="cf-npc-forge-app-shell">
  <div class="cf-npc-forge-host npc-forge-editor-host" data-cf-npc-forge-host></div>
  <div class="cf-npc-forge-host-actions">
    <button type="button" data-action="npcGenerate">
      <i class="fa-solid fa-dice"></i> {{localize "CAMPAIGN_FORGE.Integrations.Npc.Generate"}}
    </button>
    <button type="button" data-action="npcCommit">
      <i class="fa-solid fa-check"></i> {{localize "CAMPAIGN_FORGE.Integrations.Npc.Commit"}}
    </button>
    <button type="button" data-action="npcCancel">
      <i class="fa-solid fa-xmark"></i> {{localize "CAMPAIGN_FORGE.Actions.Cancel"}}
    </button>
  </div>
</div>
