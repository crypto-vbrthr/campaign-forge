                  <i class="fa-solid fa-plus"></i>
                  {{localize "CAMPAIGN_FORGE.Actions.AddSessionChange"}}
                </button>
                <button type="button" data-action="endSession">
                  <i class="fa-solid fa-stop"></i>
                  {{localize "CAMPAIGN_FORGE.Actions.EndSession"}}
